# Linux-скрипты и пакетные файлы — всегда LF (CRLF ломает шебанг и dpkg)
linux/controlgui          text eol=lf
linux/build-deb.sh        text eol=lf
linux/DEBIAN/postinst     text eol=lf
linux/DEBIAN/prerm        text eol=lf
linux/DEBIAN/postrm       text eol=lf
linux/DEBIAN/control      text eol=lf
linux/appimage/AppRun     text eol=lf
*.sh                      text eol=lf
*.py                      text eol=lf
*.swift                   text eol=lf
controlgui-window.py      text eol=lf
# серты — без конвертации концов строк (CRLF может повредить PEM при пиннинге)
*.pem                     -text
lib/central-cert.pem      -text
