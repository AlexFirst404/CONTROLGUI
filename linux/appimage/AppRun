#!/bin/sh
# Точка входа AppImage CONTROLGUI. Поднимает панель на встроенном Node и
# открывает её — нативным окном (flavor=app) или в браузере (flavor=browser).
set -u
HERE="$(dirname "$(readlink -f "$0")")"
FLAVOR="$(cat "$HERE/flavor" 2>/dev/null || echo browser)"

# встроенный node имеет приоритет; панель и данные — как у .deb-версии
export PATH="$HERE/usr/bin:$PATH"
NODE="$HERE/usr/bin/node"
[ -x "$NODE" ] || NODE="node"
export CONTROLGUI_DATA="${CONTROLGUI_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/controlgui}"
mkdir -p "$CONTROLGUI_DATA"

PORT="${CONTROLGUI_PORT:-8400}"
URL="http://127.0.0.1:$PORT"

# Панель запускаем из стабильной копии, а не из точки монтирования AppImage:
# после закрытия окна образ отмонтируется, и node, запущенный из /tmp/.mount_*,
# начал бы отдавать 404 (файлы исчезли вместе с монтированием). Копия — в
# $CONTROLGUI_DATA/app/<версия>, как распаковка панели в Windows-версии.
VER="$(cat "$HERE/version" 2>/dev/null || echo 0)"
APP="$CONTROLGUI_DATA/app/$VER"
if [ ! -f "$APP/server.js" ]; then
  mkdir -p "$APP"
  cp -a "$HERE/opt/controlgui/." "$APP/"
fi

panel_up() {
  "$NODE" -e "require('http').get('$URL/',function(r){process.exit(0)}).on('error',function(){process.exit(1)})" >/dev/null 2>&1
}

if ! panel_up; then
  ( cd "$APP" && PORT="$PORT" CONTROLGUI_DATA="$CONTROLGUI_DATA" "$NODE" server.js >"$CONTROLGUI_DATA/panel.log" 2>&1 & )
  i=0
  while [ "$i" -lt 80 ]; do
    panel_up && break
    sleep 0.25
    i=$((i + 1))
  done
fi

# нативное окно (WebKitGTK). Программный рендер: иначе на части систем
# (VM, Wayland, ряд GPU-драйверов) — "Failed to create GBM buffer" и пустое окно.
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"
export WEBKIT_DISABLE_COMPOSITING_MODE="${WEBKIT_DISABLE_COMPOSITING_MODE:-1}"

# проба: установлены ли python3-gi + WebKitGTK (импорт типизаций, без окна)
webkit_ok() {
  python3 - >/dev/null 2>&1 <<'PY'
import gi
gi.require_version('Gtk', '3.0')
try:
    gi.require_version('WebKit2', '4.1')
except ValueError:
    gi.require_version('WebKit2', '4.0')
from gi.repository import Gtk, WebKit2
PY
}

if [ "$FLAVOR" = "app" ]; then
  if command -v python3 >/dev/null 2>&1 && webkit_ok; then
    if CONTROLGUI_URL="$URL" CONTROLGUI_ICON="$HERE/controlgui.png" \
         python3 "$APP/controlgui-window.py"; then
      exit 0
    fi
    echo "CONTROLGUI: окно WebKitGTK закрылось с ошибкой — открываю в браузере" >&2
  else
    echo "CONTROLGUI: не найден python3-gi/WebKitGTK — открываю в браузере." >&2
    echo "  Нативное окно: sudo apt install python3-gi gir1.2-webkit2-4.1 gir1.2-gtk-3.0" >&2
  fi
fi

# браузер: chromium --app красивее, иначе браузер по умолчанию
for B in chromium chromium-browser google-chrome google-chrome-stable; do
  if command -v "$B" >/dev/null 2>&1; then
    exec "$B" --app="$URL"
  fi
done
if command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open "$URL"
fi
echo "CONTROLGUI работает на $URL — откройте этот адрес в браузере." >&2
# держим процесс, чтобы node не осиротел, если панель запустил AppImage
wait
