#!/bin/sh
# Точка входа AppImage CONTROLGUI. Один пакет: режим (приложение/браузер)
# выбирается при первом запуске и хранится в файле; меняется в настройках панели.
set -u
HERE="$(dirname "$(readlink -f "$0")")"

# встроенный node имеет приоритет; данные — как у .deb-версии
export PATH="$HERE/usr/bin:$PATH"
NODE="$HERE/usr/bin/node"
[ -x "$NODE" ] || NODE="node"
CG_XDG_BASE="${XDG_DATA_HOME:-${HOME:-/root}/.local/share}"
if [ -z "${CONTROLGUI_DATA:-}" ]; then
  if [ "${1:-}" = "service" ] && [ "${2:-install}" = "install" ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    CG_SERVICE_HOME="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)"
    [ -n "$CG_SERVICE_HOME" ] || CG_SERVICE_HOME="/home/$SUDO_USER"
    CONTROLGUI_DATA="$CG_SERVICE_HOME/.local/share/controlgui"
  else
    CONTROLGUI_DATA="$CG_XDG_BASE/controlgui"
  fi
fi
export CONTROLGUI_DATA
PORT="${CONTROLGUI_PORT:-${PORT:-8400}}"
export PORT

# Удаляем только интеграцию AppImage. Миры, бэкапы и настройки принадлежат
# пользователю и не должны исчезать вместе с оболочкой приложения.
#   ./CONTROLGUI-<версия>-x86_64.AppImage --uninstall
if [ "${1:-}" = "--uninstall" ]; then
  rm -f "$CG_XDG_BASE/applications/controlgui-appimage.desktop" 2>/dev/null || true
  rm -f "$CG_XDG_BASE/icons/controlgui.png" 2>/dev/null || true
  command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database -q "$CG_XDG_BASE/applications" 2>/dev/null || true
  echo "CONTROLGUI: интеграция удалена. Серверы и бэкапы сохранены в $CONTROLGUI_DATA. Теперь удалите сам файл .AppImage."
  exit 0
fi

# Из временной точки монтирования нельзя ставить долговечный systemd-unit:
# после выхода AppImage его ExecStart исчезнет. Удаление старого unit допустимо.
if [ "${1:-}" = "service" ]; then
  if [ "${2:-install}" != "uninstall" ]; then
    echo "CONTROLGUI: systemd-сервис устанавливайте из .deb или серверного .tar.gz, а не из AppImage." >&2
    exit 1
  fi
  exec "$NODE" "$HERE/opt/controlgui/cli.js" "$@"
fi

mkdir -p "$CONTROLGUI_DATA"

# интеграция в меню приложений (один раз): ярлык, указывающий на сам AppImage,
# чтобы запускать из списка приложений, а не только из файла
DESKTOP_DST="$CG_XDG_BASE/applications/controlgui-appimage.desktop"
if [ -n "${APPIMAGE:-}" ] && [ ! -f "$DESKTOP_DST" ]; then
  ICON_DST="$CG_XDG_BASE/icons/controlgui.png"
  mkdir -p "$(dirname "$DESKTOP_DST")" "$(dirname "$ICON_DST")"
  cp -f "$HERE/controlgui.png" "$ICON_DST" 2>/dev/null || true
  cat > "$DESKTOP_DST" <<EOF
[Desktop Entry]
Type=Application
Name=CONTROLGUI
Comment=Панель Minecraft-серверов
Exec="$APPIMAGE"
Icon=$ICON_DST
Categories=Game;Utility;
Terminal=false
StartupWMClass=CONTROLGUI
EOF
  command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database -q "$(dirname "$DESKTOP_DST")" 2>/dev/null || true
fi

URL="http://127.0.0.1:$PORT"

# Панель запускаем из стабильной копии (не из точки монтирования образа: после
# закрытия окна образ отмонтируется). Переустанавливаем при смене сборки.
VER="$(cat "$HERE/version" 2>/dev/null || echo 0)"
BUILD="$(cat "$HERE/build" 2>/dev/null || echo "$VER")"
APP="$CONTROLGUI_DATA/app/$VER"
if [ ! -f "$APP/server.js" ] || [ "$(cat "$APP/.build" 2>/dev/null || echo)" != "$BUILD" ]; then
  rm -rf "$APP"
  mkdir -p "$APP"
  cp -a "$HERE/opt/controlgui/." "$APP/"
  printf '%s' "$BUILD" > "$APP/.build"
fi

# CLI-команды: ./CONTROLGUI-*.AppImage serve|start|stop|status|server|remote|tui|connect …
case "${1:-}" in
  serve|start|stop|status|server|servers|remote|tui|connect|help|--help|-h)
    exec "$NODE" "$APP/cli.js" "$@"
    ;;
esac

# клиент-режим: подключение к удалённой панели (файл пишет cli.js в $CONTROLGUI_DATA/data/)
CLIENT_MODE=0
REMOTE_URL_FILE="$CONTROLGUI_DATA/data/remote-connect"
if [ "${1:-}" = "--connect" ] && [ -n "${2:-}" ]; then
  URL="$2"; CLIENT_MODE=1
elif [ "${1:-}" != "--local" ] && [ -s "$REMOTE_URL_FILE" ]; then
  URL="$(head -n1 "$REMOTE_URL_FILE" | tr -d '[:space:]')"
  CLIENT_MODE=1
fi

# режим открытия (тот же файл, что пишет панель: ~/.local/share/controlgui/launch-mode)
MODE_FILE="$CG_XDG_BASE/controlgui/launch-mode"
MODE="$(cat "$MODE_FILE" 2>/dev/null || echo)"
if [ "$MODE" != "app" ] && [ "$MODE" != "browser" ]; then
  if command -v zenity >/dev/null 2>&1 && zenity --question --title="CONTROLGUI" \
       --text="Как открывать CONTROLGUI?\n\n«Приложение» — отдельное окно\n«Браузер» — в браузере по умолчанию\n\n(потом можно сменить в настройках панели)" \
       --ok-label="Приложение" --cancel-label="Браузер" 2>/dev/null; then
    MODE="app"
  elif command -v zenity >/dev/null 2>&1; then
    MODE="browser"
  else
    MODE="app" # без zenity — приложение, с откатом в браузер
  fi
  mkdir -p "$(dirname "$MODE_FILE")"
  printf '%s\n' "$MODE" > "$MODE_FILE"
fi

panel_up() {
  "$NODE" -e "require('http').get('$URL/',function(r){process.exit(0)}).on('error',function(){process.exit(1)})" >/dev/null 2>&1
}
# локальный режим: поднимаем панель при необходимости; клиент-режим — панель удалённая
if [ "$CLIENT_MODE" = "0" ] && ! panel_up; then
  ( cd "$APP" && PORT="$PORT" CONTROLGUI_DATA="$CONTROLGUI_DATA" "$NODE" server.js >"$CONTROLGUI_DATA/panel.log" 2>&1 & )
  i=0
  while [ "$i" -lt 80 ]; do panel_up && break; sleep 0.25; i=$((i + 1)); done
fi

# нативное окно WebKitGTK: программный рендер, иначе бывает пустое окно (GBM)
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"
export WEBKIT_DISABLE_COMPOSITING_MODE="${WEBKIT_DISABLE_COMPOSITING_MODE:-1}"
webkit_ok() {
  python3 - >/dev/null 2>&1 <<'PY'
import gi
gi.require_version('Gtk', '3.0')
try:
    gi.require_version('WebKit2', '4.1')
except ValueError:
    gi.require_version('WebKit2', '4.0')
from gi.repository import Gtk, WebKit2
PY
}
open_browser() {
  for B in chromium chromium-browser google-chrome google-chrome-stable; do
    command -v "$B" >/dev/null 2>&1 && exec "$B" --app="$URL"
  done
  command -v xdg-open >/dev/null 2>&1 && exec xdg-open "$URL"
  echo "CONTROLGUI работает на $URL — откройте этот адрес в браузере." >&2
  wait
}

if [ "$MODE" = "app" ] && command -v python3 >/dev/null 2>&1 && webkit_ok; then
  if CONTROLGUI_URL="$URL" CONTROLGUI_ICON="$HERE/controlgui.png" CONTROLGUI_REMOTE="$CLIENT_MODE" python3 "$APP/controlgui-window.py"; then
    exit 0
  fi
  echo "CONTROLGUI: окно WebKitGTK не запустилось — открываю в браузере" >&2
elif [ "$MODE" = "app" ]; then
  echo "CONTROLGUI: нет python3-gi/WebKitGTK — открываю в браузере (sudo apt install python3-gi gir1.2-webkit2-4.1 gir1.2-gtk-3.0)" >&2
fi
open_browser
