#!/bin/sh
set -e

# Данные панели принадлежат пользователю, а не пакету: обычное удаление или purge
# не должны уничтожать миры, бэкапы и настройки. Полное удаление данных остаётся
# отдельным осознанным действием пользователя.
case "$1" in
  remove|purge)
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database -q /usr/share/applications 2>/dev/null || true
    fi
    ;;
esac

exit 0
