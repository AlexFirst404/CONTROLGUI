#!/usr/bin/env python3
# CONTROLGUI как НАТИВНОЕ приложение: поднимает локальную панель (node) и
# показывает её в окне WebKitGTK (аналог десктоп-обёртки WebView2 на Windows),
# без браузера. Окно — отдельная запись среди приложений.
import os
import sys
import time
import socket
import subprocess

import gi
gi.require_version('Gtk', '3.0')
# WebKit2 4.1 (новые дистрибутивы) или 4.0 (Ubuntu 22.04 и старее)
try:
    gi.require_version('WebKit2', '4.1')
except ValueError:
    gi.require_version('WebKit2', '4.0')
from gi.repository import Gtk, WebKit2  # noqa: E402

APP_DIR = '/opt/controlgui'
PORT = os.environ.get('CONTROLGUI_PORT', '8400')
URL = 'http://127.0.0.1:%s' % PORT
ICON = '/usr/share/icons/hicolor/256x256/apps/controlgui.png'


def panel_up():
    try:
        s = socket.create_connection(('127.0.0.1', int(PORT)), 0.4)
        s.close()
        return True
    except OSError:
        return False


def error_box(text):
    d = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR,
                          buttons=Gtk.ButtonsType.OK, text=text)
    d.run()
    d.destroy()


def start_panel():
    env = dict(os.environ)
    env['PORT'] = PORT
    env.setdefault('CONTROLGUI_DATA',
                   os.path.join(os.path.expanduser('~'), '.local', 'share', 'controlgui'))
    os.makedirs(env['CONTROLGUI_DATA'], exist_ok=True)
    try:
        log = open(os.path.join(env['CONTROLGUI_DATA'], 'panel.log'), 'a')
        subprocess.Popen(['node', 'server.js'], cwd=APP_DIR, env=env, stdout=log, stderr=log)
    except FileNotFoundError:
        return False
    for _ in range(80):
        if panel_up():
            return True
        time.sleep(0.25)
    return panel_up()


def main():
    if not panel_up():
        if not start_panel():
            error_box('Не удалось запустить панель.\nУбедитесь, что установлен Node.js '
                      '(sudo apt install nodejs). Лог: ~/.local/share/controlgui/panel.log')
            return

    win = Gtk.Window()
    win.set_title('CONTROLGUI — панель Minecraft-серверов')
    win.set_default_size(1380, 900)
    try:
        win.set_wmclass('CONTROLGUI', 'CONTROLGUI')  # группировка в панели задач
    except Exception:
        pass
    if os.path.exists(ICON):
        try:
            win.set_icon_from_file(ICON)
        except Exception:
            pass

    web = WebKit2.WebView()
    web.load_uri(URL)
    win.add(web)
    win.connect('destroy', Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
