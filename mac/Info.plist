<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>CONTROLGUI</string>
  <key>CFBundleDisplayName</key>
  <string>CONTROLGUI</string>
  <key>CFBundleIdentifier</key>
  <string>com.alexfirst.controlgui</string>
  <key>CFBundleVersion</key>
  <string>__VERSION__</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleExecutable</key>
  <string>controlgui</string>
  <key>CFBundleIconFile</key>
  <string>controlgui</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- запрет второго экземпляра: не плодим лишний node на том же порту -->
  <key>LSMultipleInstancesProhibited</key>
  <true/>
  <!-- панель на http://127.0.0.1 — loopback исключён из ATS через NSAllowsLocalNetworking
       (IP-литералы как NSExceptionDomains не работают, поэтому отдельный блок не нужен) -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
