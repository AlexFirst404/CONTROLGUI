# данные конкретной машины — не для репозитория
/servers/
/data/
/backups/
*.log
*.part

# временное
node_modules/
.claude/

# собранный .deb (воспроизводится: node linux/build-deb.js)
linux/*.deb

# собранный .AppImage и кэш сборки (воспроизводится: linux/build-appimage.sh)
linux/*.AppImage
linux/.appimage-cache/
linux/AppDir-*/
